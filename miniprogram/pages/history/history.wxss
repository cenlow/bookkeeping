.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.title {
  width: 100%;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

/* 卡片列表 */
.list {
  width: 90%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 单张卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.room-id {
  font-weight: bold;
  color: #333;
}

.time {
  font-size: 24rpx;
  color: #999;
}

/* 成员行 */
.card-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member {
  display: flex;
  align-items: center;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.name {
  flex: 1;
  font-size: 28rpx;
  color: #444;
}

/* 分数 */
.score {
  font-size: 28rpx;
  font-weight: bold;
}

.win {
  color: #07c160; /* 绿色 */
}

.lose {
  color: #ee0a24; /* 红色 */
}

/* 空状态 */
.empty {
  text-align: center;
  color: #999;
  margin-top: 200rpx;
}