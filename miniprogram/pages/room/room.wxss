page {
  height: 100%;
}
.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 20rpx;
}
.record-wrapper {
  flex: 1;
  min-height: 0;        /* 必须 */
  overflow: hidden;     /* 必须 */
}
/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.nav-left, .nav-right {
  display: flex;
  align-items: center;
}

.icon {
  width: 40rpx;
  height: 40rpx;
  margin: 0 10rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
}
/* 外层滚动容器 */
.user-list-scroll {
  width: 100%;
  white-space: nowrap;
  box-sizing: border-box;
}
/* 用户列表 */
.user-list {
  display: flex;
  flex-wrap: nowrap;   /* ✅ 禁止换行 */
  align-items: flex-start;
}

.user-item {
  flex: 0 0 auto;      /* ✅ 不伸缩 */
  width: 120rpx;
  margin: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
}

.nickname {
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100rpx;
}

.score {
  font-size: 28rpx;
  font-weight: bold;
}

.positive {
  color: #f56c6c; /* 红色正数 */
}

.negative {
  color: #67c23a; /* 绿色负数 */
}

.self {
  order: -1; /* 自己排在最前面 */
}

.invite, .tea {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.tea-money {
  font-size: 24rpx;
  color: #f56c6c;
  margin-top: 5rpx;
}

/* 提示文字 */
.tip {
  background-color: #ffd700;
  color: #333;
  padding: 10rpx;
  text-align: center;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

/* 广告 */
.ad {
  margin-bottom: 20rpx;
}

.ad-img {
  width: 100%;
  border-radius: 10rpx;
}

/* 转账记录 */
/* 聊天记录容器 */
.record-list {
  width: 90%;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx; /* 每条消息之间的垂直间距 */
}

/* 单行消息容器 */
.chat-row {
  display: flex;
  align-items: flex-start; /* 头像和气泡顶部对齐 */
  width: 100%;
}

/* 别人发的：靠左 */
.row-other {
  justify-content: flex-start;
}

/* 自己发的：靠右 */
.row-self {
  justify-content: flex-end;
}

/* 头像通用样式 */
.chat-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx; /* 微信头像通常是圆角矩形 */
  flex-shrink: 0;
}

/* 气泡通用样式 */
.chat-bubble {
  max-width: 65%; /* 限制气泡最大宽度 */
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin: 0 16rpx; /* 头像和气泡的间距 */
  word-wrap: break-word;
}

/* 别人的气泡：灰色背景 */
.bubble-other {
  background-color: #ffffff;
  border: 1px solid #f0f0f0;
}

/* 自己的气泡：绿色背景 */
.bubble-self {
  background-color: #95ec69; /* 微信聊天气泡绿 */
}

/* 昵称 */
.chat-nickname {
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 8rpx;
}

/* 转账内容 */
.chat-content {
  font-size: 30rpx;
  line-height: 1.4;
  display: flex;
  align-items: center;
}

.target-name {
  font-weight: bold;
  padding-left: 5rpx;
  padding-right: 5rpx;
}

/* 金额颜色 */
.amount.positive {
  color: #07c160; /* 赢钱/收入 */
}
.amount.negative {
  padding-left: 10rpx;
  color: #ee0a24; /* 输钱/支出 */
}

/* 时间 */
.chat-time {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
  text-align: right; /* 时间通常靠右 */
}

/* 底部按钮 */
.bottom-btn {
  position: fixed;
  bottom: 30rpx;
  right: 30rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: #f56c6c;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(245, 108, 108, 0.5);
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
}
.bottom-bar {
  position: fixed;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 40rpx;
}

.btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.btn .icon {
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 10rpx;
}

.settle {
  background-color: #e74c3c;
  color: #fff;
}
/* 遮罩层 */
.qr-modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

/* 弹窗主体 */
.qr-box {
  width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 40rpx 36rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 二维码 */
.qr-box .qr {
  width: 360rpx;
  height: 360rpx;
  margin-bottom: 36rpx;
}

/* 分享按钮 */
.qr-box .share-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  padding: 0;
}

/* 右上角关闭按钮 */
.close-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 44rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
}

.settle-list{
  display: block;
  width: 80%;
  background-color: #ffdf;
  padding: 10rpx;
  margin: 10ropx;
}
.item{
  padding: 10rpx;
  margin: 10rpx;
  color: red;
  display: block;
  padding-left: 100rpx;
}

.effect-mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  /* background: rgba(0, 0, 0, 0.35); */
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  pointer-events: none;
}

.effect-img {
  width: 200rpx;
  height: 200rpx;
}