<view class="container">
  <!-- 结算结果 -->
  <view class="list">
    <view wx:for="{{transfers}}" wx:key="index" class="item">
      <text>{{item.fromName}} → {{item.targetNickname}} ：{{item.amount}} 元</text>
    </view>
  </view>

  <!-- ✅ 底部返回首页按钮 -->
  <view class="footer">
    <button type="primary" bindtap="goHome">
      返回首页
    </button>
  </view>
</view>